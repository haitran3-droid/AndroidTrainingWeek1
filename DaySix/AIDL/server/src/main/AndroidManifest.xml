<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Ca hai APK debug phai duoc ky cung certificate. -->
    <permission android:name="com.example.server.permission.BOOK_SERVICE"
        android:protectionLevel="signature" />
    <application android:label="@string/app_name" android:theme="@style/AppTheme"
        android:allowBackup="false" android:supportsRtl="true">
        <activity android:name=".ServerActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service android:name=".BookManagerService" android:exported="true"
            android:permission="com.example.server.permission.BOOK_SERVICE"
            android:process=":remote" />
    </application>
</manifest>
